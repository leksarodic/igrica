[application]
config/name="The Long Note"
config/description="An original open-valley adventure about a valley kept alive by a song."
config/version="0.1.3"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.11, 0.15, 0.16, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="LongNote"

[autoload]
Events="*res://scripts/core/events.gd"
Settings="*res://scripts/core/settings.gd"
InputRouter="*res://scripts/core/input_router.gd"
Game="*res://scripts/core/game.gd"
AudioDirector="*res://scripts/core/audio_director.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.11, 0.15, 0.16, 1)

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=18.0

[input_devices]
pointing/emulate_touch_from_mouse=false
